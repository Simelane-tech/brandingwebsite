# ============================================
# BENTOKS INVESTMENTS EMAIL API CONFIGURATION
# ============================================
# Copy this file to .env and fill in your own real values.
# NEVER commit the real .env file or real credentials to git.

# Server configuration
PORT=3000
# Comma-separated list of origins allowed to call this API, e.g.:
# ALLOWED_ORIGINS=https://www.bentoks.com,https://bentoks.com
# Use * only for local development — never in production.
ALLOWED_ORIGINS=*

# Gmail SMTP Configuration (for sending emails)
# IMPORTANT: To use Gmail, you need to:
# 1. Enable 2-Step Verification on your Google Account
# 2. Create an "App Password" here: https://myaccount.google.com/apppasswords
# 3. Use that 16-character app password below (without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_char_app_password_here

# Email addresses
# Where to receive contact form submissions, quote requests, newsletter signups
ADMIN_EMAIL=your-email@gmail.com
# The "From" address shown on sent emails (usually same as SMTP_USER)
FROM_EMAIL="Bentoks Investments <your-email@gmail.com>"

# Website URL (used in email links, e.g. the "Request a Quote" button in the
# newsletter welcome email). OPTIONAL — leave unset/commented out and the
# server will auto-detect the correct URL from each incoming request, so it
# works correctly no matter what domain you deploy to (Vercel, Render, a
# custom domain, localhost, etc.) with zero config. Only set this if your
# frontend is hosted on a DIFFERENT domain than this backend.
# WEBSITE_URL=https://your-actual-domain.com
